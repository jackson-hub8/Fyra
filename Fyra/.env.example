# UPDATE AS BUILDING APP
# Replace with your actual environment variables
# put .env file under Fyra folder .gitignore wont commit it so doesn't matter
DATABASE_URL="Contact Jackson"
SERVER_PORT=Contact Jackson

# For signup email verification (6-digit code). Gmail: use an App Password.
EMAIL_USER="your-gmail@gmail.com"
EMAIL_PASS="your-app-password"

# Vercel Blob (profile photos). Create a Blob store in Vercel and add token here.
BLOB_READ_WRITE_TOKEN=""

