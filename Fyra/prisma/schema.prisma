/// file: schema.prisma
/// Jackson Hurley, Kaitlyn Maes, Cam Horine
/// Defines the database schema for the application using Prisma ORM

generator client {
  provider      = "prisma-client-js"
  // Vercel serverless runs Linux (glibc + OpenSSL 3); include alongside native for local dev.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Users {
  email                String   @id @db.VarChar(255)
  name                 String   @db.VarChar(255)
  passwordHash         String   @db.VarChar(255) // Salted hash stored here
  isMatched            Boolean  @default(false)
  isActive             Boolean  @default(true)
  emailVerified        Boolean  @default(false)
  profileSetupComplete Boolean  @default(false)
  isAdmin              Boolean  @default(false)
  createdAt            DateTime @default(now()) @db.Timestamp(6)

  // Relations
  userProfile          UserProfiles?
  publicPreferences    PublicPreferences?
  privatePreferences   PrivatePreferences?
  privateQuestionnaire PrivateQuestionnaire?
  petPeeves            PetPeeves[]
  matchesAsUser1       Matches[] @relation("User1Matches")
  matchesAsUser2       Matches[] @relation("User2Matches")
  possibleMatchesAsUser1 PossibleMatches[] @relation("PossibleMatchUser1")
  possibleMatchesAsUser2 PossibleMatches[] @relation("PossibleMatchUser2")
  matchRequestsFrom      MatchRequest[]    @relation("MatchRequestFrom")
  matchRequestsTo        MatchRequest[]    @relation("MatchRequestTo")
  reportsMade            ProfileReport[]   @relation("ReportsMade")
  reportsReceived        ProfileReport[]   @relation("ReportsReceived")

  @@map("users")
}

model ProfileReport {
  id             Int      @id @default(autoincrement())
  reporterEmail  String   @db.VarChar(255)
  reportedEmail  String   @db.VarChar(255)
  reason         String   @db.VarChar(50)
  createdAt      DateTime @default(now()) @db.Timestamp(6)

  reporter Users @relation("ReportsMade", fields: [reporterEmail], references: [email], onDelete: Cascade)
  reported Users @relation("ReportsReceived", fields: [reportedEmail], references: [email], onDelete: Cascade)

  @@index([reportedEmail])
  @@map("profile_reports")
}

model UserProfiles {
  id                   Int       @id @default(autoincrement())
  userEmail            String    @unique @db.VarChar(255)
  profilePicture       String?   @db.VarChar(500)
  bio                  String?   @db.Text
  major                String?   @db.VarChar(100)
  graduationYear       Int?
  gender               String?   @db.VarChar(50)
  pronouns             String?   @db.VarChar(50)
  dietaryRestrictions  String?   @db.VarChar(255)
  topInterests         String?   @db.Text
  dailyLife            String?   @db.Text
  createdAt            DateTime  @default(now()) @db.Timestamp(6)

  // Relations
  user Users @relation(fields: [userEmail], references: [email], onDelete: Cascade)
  profilePhoto UserProfilePhotos?

  @@map("user_profiles")
}

model UserProfilePhotos {
  id          Int      @id @default(autoincrement())
  userEmail   String   @unique @db.VarChar(255)
  blobUrl     String   @db.VarChar(2048)
  blobPathname String  @db.VarChar(512)
  contentType String?  @db.VarChar(100)
  sizeBytes   Int?
  width       Int?
  height      Int?
  createdAt   DateTime @default(now()) @db.Timestamp(6)
  updatedAt   DateTime @updatedAt @db.Timestamp(6)

  userProfile UserProfiles @relation(fields: [userEmail], references: [userEmail], onDelete: Cascade)

  @@map("user_profile_photos")
}

model PublicPreferences {
  id              Int      @id @default(autoincrement())
  userEmail       String   @unique @db.VarChar(255)
  sleepSchedule   String?  @db.VarChar(100)
  cleanliness     String?  @db.VarChar(50)
  noiseLevel      String?  @db.VarChar(50)
  guestsFrequency String?  @db.VarChar(50)
  socialLevel     String?  @db.VarChar(50)

  // Relations
  user Users @relation(fields: [userEmail], references: [email], onDelete: Cascade)

  @@map("public_preferences")
}

model PrivatePreferences {
  id                 Int      @id @default(autoincrement())
  userEmail          String   @unique @db.VarChar(255)
  religiousPreference String? @db.VarChar(100)
  politicalLeaning   String?  @db.VarChar(100)
  dealBreakers       String?  @db.Text
  drinking           String?  @db.VarChar(50)
  smoking            String?  @db.VarChar(50)

  // Relations
  user Users @relation(fields: [userEmail], references: [email], onDelete: Cascade)

  @@map("private_preferences")
}

model PrivateQuestionnaire {
  id                    Int      @id @default(autoincrement())
  userEmail             String   @unique @db.VarChar(255)
  gender                String?  @db.VarChar(100)
  sexAssignedAtBirth    String?  @db.VarChar(10)
  classStanding         String?  @db.VarChar(50)
  adaAccommodations     String?  @db.Text
  animalAllergies       String?  @db.Text
  varsitySport          String?  @db.Text
  smoking               String?  @db.VarChar(50)
  cannabis              String?  @db.VarChar(50)
  alcohol               String?  @db.VarChar(50)
  roomTemp              String?  @db.VarChar(50)
  bedroomDescription    String?  @db.Text
  sleepType             String?  @db.VarChar(100)
  weekdayBedtime        String?  @db.VarChar(50)
  freeTime              String?  @db.Text
  campusActivity        String?  @db.VarChar(100)
  visitorFrequency      String?  @db.VarChar(50)
  weekendHomeFrequency  String?  @db.VarChar(50)
  firstClassTime        String?  @db.VarChar(50)
  musicPreference       String?  @db.VarChar(100)
  politicalViews        String?  @db.VarChar(100)
  religion              String?  @db.VarChar(100)
  studyEnvironment      String?  @db.VarChar(100)
  intendedMajor         String?  @db.Text
  vehicleToCampus       String?  @db.VarChar(50)

  user Users @relation(fields: [userEmail], references: [email], onDelete: Cascade)

  @@map("private_questionnaire")
}

model PetPeeves {
  id        Int      @id @default(autoincrement())
  userEmail String   @db.VarChar(255)
  petPeeve  String   @db.VarChar(255)
  severity  String   @db.VarChar(50)
  isPublic  Boolean  @default(true)

  // Relations
  user Users @relation(fields: [userEmail], references: [email], onDelete: Cascade)

  @@map("pet_peeves")
}

model SwipeActions {
  id          Int      @id @default(autoincrement())
  swiperEmail String   @db.VarChar(255)
  targetEmail String   @db.VarChar(255)
  action      String   @db.VarChar(10) // 'like' | 'pass'
  createdAt   DateTime @default(now()) @db.Timestamp(6)
  updatedAt   DateTime @updatedAt @db.Timestamp(6)

  @@unique([swiperEmail, targetEmail])
  @@index([swiperEmail])
  @@index([targetEmail])
  @@map("swipe_actions")
}

model MatchRequest {
  id        Int      @id @default(autoincrement())
  fromEmail String   @db.VarChar(255)
  toEmail   String   @db.VarChar(255)
  createdAt DateTime @default(now()) @db.Timestamp(6)

  fromUser Users @relation("MatchRequestFrom", fields: [fromEmail], references: [email], onDelete: Cascade)
  toUser   Users @relation("MatchRequestTo", fields: [toEmail], references: [email], onDelete: Cascade)

  @@unique([fromEmail, toEmail])
  @@index([fromEmail])
  @@index([toEmail])
  @@map("match_requests")
}

model PossibleMatches {
  id              Int      @id @default(autoincrement())
  userEmail1      String   @db.VarChar(255)
  userEmail2      String   @db.VarChar(255)
  similarityScore Float
  createdAt       DateTime @default(now()) @db.Timestamp(6)

  user1 Users @relation("PossibleMatchUser1", fields: [userEmail1], references: [email], onDelete: Cascade)
  user2 Users @relation("PossibleMatchUser2", fields: [userEmail2], references: [email], onDelete: Cascade)

  @@unique([userEmail1, userEmail2])
  @@index([userEmail1])
  @@index([userEmail2])
  @@map("possible_matches")
}

model Matches {
  id         Int      @id @default(autoincrement())
  userEmail1 String   @db.VarChar(255)
  userEmail2 String   @db.VarChar(255)
  matchScore Float?
  status     String   @db.VarChar(50)
  matchedAt  DateTime @default(now()) @db.Timestamp(6)

  // Relations
  user1 Users @relation("User1Matches", fields: [userEmail1], references: [email], onDelete: Cascade)
  user2 Users @relation("User2Matches", fields: [userEmail2], references: [email], onDelete: Cascade)
  calendarEvents CalendarEvents[]
  chores Chores[]

  // Prevent duplicate matches between same two users (regardless of order)
  @@unique([userEmail1, userEmail2])
  @@index([userEmail1])
  @@index([userEmail2])
  @@map("matches")
}

model CalendarEvents {
  id           Int      @id @default(autoincrement())
  matchId      Int
  creatorEmail String   @db.VarChar(255)
  title        String   @db.VarChar(500)
  description  String?  @db.Text
  startDate    String   @db.VarChar(10)
  endDate      String   @db.VarChar(10)
  startTime    String?  @db.VarChar(5)
  endTime      String?  @db.VarChar(5)
  isAllDay     Boolean
  createdAt    DateTime @default(now()) @db.Timestamp(6)

  match Matches @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId])
  @@map("calendar_events")
}

model Chores {
  id        Int      @id @default(autoincrement())
  matchId   Int
  title     String   @db.VarChar(500)
  dueDate   String   @db.VarChar(10)
  completed Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamp(6)

  match Matches @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId])
  @@map("chores")
}

model PendingSignups {
  email            String   @id @db.VarChar(255)
  firstName        String   @db.VarChar(100)
  lastName         String   @db.VarChar(100)
  passwordHash     String   @db.VarChar(255)
  verificationCode String   @db.VarChar(6)
  codeExpiresAt    DateTime @db.DateTime(6)
  createdAt        DateTime @default(now()) @db.Timestamp(6)

  @@map("pending_signups")
}